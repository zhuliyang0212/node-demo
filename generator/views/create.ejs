<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>新增书籍</title>
</head>

<body>
  <h1>
    新增书籍
  </h1>
  <form action="/book/createBook" method="post">
    <div>
      <label for="name">书名</label>
      <input type="text" name="name">
    </div>
    <div>
      <label for="name">作者</label>
      <input type="text" name="author">
    </div>
    <div>
      <label for="name">价格</label>
      <input type="number" name="price">
    </div>
    <div>
      <label for="name">热门</label>
      <input type="radio" id="is_hot" name="is_hot" value="true" />
      <label for="is_hot">是</label>
      <input type="radio" id="is_hot" name="is_hot" value="false" />
      <label for="is_hot">否</label>
    </div>
    <div>
      <label for="name">标签</label>
      <input type="select" name="tags">
    </div>
    <div>
      <label for="name">发售时间</label>
      <input type="date" name="pub_time">
    </div>
    <button>提交</button>
  </form>
</body>

</html>